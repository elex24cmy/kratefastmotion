# KrateFastMotion provider keys.
# Copy this file to `.env` (same folder) and fill in the ones you use.
# `npm run dev` loads `.env` automatically; a server restart is required.
#
# Leave everything empty and the app runs in `mock` mode (offline simulation).

# --- LLM providers (pick one) -------------------------------------------
# NVIDIA NIM (free tier at build.nvidia.com; OpenAI-compatible)
# NVIDIA_API_KEY=nvapi-...
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# OPENAI_API_KEY=sk-...
# MODEL=gpt-4o-mini

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash

# One key, many models (OpenAI-compatible endpoint):
# OPENROUTER_API_KEY=sk-or-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# MODEL=anthropic/claude-sonnet-4

# DEEPSEEK_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
# TOGETHER_API_KEY=...

# Local models, no key needed:
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# Force a provider instead of auto-detecting the first configured one:
# LLM_PROVIDER=anthropic

# --- Optional media providers -------------------------------------------
# STABILITY_API_KEY=
# ELEVENLABS_API_KEY=
# RUNWAY_API_KEY=
# LUMA_API_KEY=

# --- Server --------------------------------------------------------------
# PORT=7000
# DB_PATH=./data/kratefastmotion.db
